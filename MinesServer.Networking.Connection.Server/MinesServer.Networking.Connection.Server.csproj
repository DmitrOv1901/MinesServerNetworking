<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetCoreServer" Version="8.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinesServer.Networking.Connection\MinesServer.Networking.Connection.csproj" />
  </ItemGroup>

  <!--
    Промежуточные файлы собираются в obj~\ (см. Directory.Build.props), но старый
    каталог obj/ может остаться после смены пути — без исключения его *.cs
    попадают в компиляцию и дают CS0579 (дублирующиеся сгенерированные атрибуты).
  -->
  <ItemGroup>
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>

</Project>
